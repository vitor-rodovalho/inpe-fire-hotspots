# =============================================================================
# Configuração única do projeto
#
# Todos os scripts (bash e Python) leem as constantes daqui. Para reproduzir o
# projeto em outra conta GCP, basta mudar os valores desta seção.
#
# Como carregar no terminal:
#   set -a; source config.env; set +a
#
# Valores pessoais (conta de faturamento, e-mails da equipe) ficam em
# config.local.env, que não vai para o GitHub. Veja config.local.env.example.
# =============================================================================

# --- Projeto GCP --------------------------------------------------------------
PROJECT_ID=inpe-fire-hotspots
PROJECT_NAME="INPE Fire Hotspots"
REGIAO=us-central1

# --- Orçamento ----------------------------------------------------------------
ORCAMENTO_USD=50                         # Alertas em 50%, 90% e 100% deste valor
ORCAMENTO_NOME=${PROJECT_ID}-budget

# --- Cloud Storage ------------------------------------------------------------
BUCKET=${PROJECT_ID}-data
PASTA_RAW_MENSAL=raw/mensal
PASTA_RAW_DIARIO=raw/diario
PASTA_MANIFESTO=raw/manifesto
PASTA_DATAFLOW_TMP=dataflow/tmp
PASTA_DATAFLOW_STAGING=dataflow/staging
PASTA_MODELOS=modelos/foco_intenso

# --- BigQuery -----------------------------------------------------------------
DATASET=focos
DATA_CORTE=2026-10-01                   # Antes: batch (mensal). A partir dela: streaming (diário)

# --- Pub/Sub ------------------------------------------------------------------
TOPICO=focos-replay
ASSINATURA=focos-replay-dataflow
RETENCAO_MENSAGENS=1d                    # Quanto tempo a assinatura guarda mensagens não lidas
ACK_DEADLINE_S=60

# --- Contas de serviço --------------------------------------------------------
SA_DATAFLOW=sa-dataflow-focos
SA_API=sa-api-foco-intenso

# --- Dataflow (streaming) -----------------------------------------------------
DATAFLOW_JOB=focos-streaming
DATAFLOW_MAQUINA=n1-standard-2
DATAFLOW_MAX_WORKERS=1
DATAFLOW_DISCO_GB=30

# --- Cloud Run (Frente D) -----------------------------------------------------
CLOUD_RUN_SERVICO=api-foco-intenso

# --- Fonte de dados do INPE ---------------------------------------------------
INPE_URL_BASE=https://dataserver-coids.inpe.br/queimadas/queimadas/focos/csv
INPE_PASTA_MENSAL=mensal/Brasil
INPE_PASTA_DIARIO=diario/Brasil
MES_INICIO=2025-10                       # Primeiro mês do histórico (batch)
MES_FIM=2026-09                          # Último mês do histórico (batch)
DIA_INICIO=2026-10-01                   # Primeiro dia do streaming (replay)
DIA_FIM=                                 # Vazio = ontem

# --- Testes sem nuvem ---------------------------------------------------------
PASTA_LOCAL=dados                        # Fica fora do Git (.gitignore)
ARQUIVO_MENSAGENS_LOCAL=${PASTA_LOCAL}/mensagens.jsonl
PASTA_SAIDA_LOCAL=${PASTA_LOCAL}/pipeline
