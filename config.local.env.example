# Copie para config.local.env e preencha. Este arquivo NÃO vai para o GitHub
# cp config.local.env.example config.local.env

# Conta de faturamento que paga o projeto (gcloud billing accounts list)
BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX

# E-mails da equipe, separados por espaço. Recebem acesso de editor no projeto
EMAILS_EQUIPE="pessoa1@gmail.com pessoa2@gmail.com pessoa3@gmail.com"

# Token fixo da API (cabeçalho "Authorization: Bearer <token>" em POST /predict).
# Vazio: o api/subir_api.sh gera um e grava aqui. Para gerar à mão:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=
